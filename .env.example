# Settings for docker-compose.yml — copy this file to .env and adjust it.

# Host directory for persistent data (config/ and data/ are created inside).
# Keep it outside the project so rebuilding or deleting the container never touches it.
AXPERT_STORAGE_DIR=/srv/docker/axpert_monitor

# Host port for the web interface
AXPERT_WEB_PORT=60606

# Container timezone (daily energy counters reset at local midnight)
TZ=Europe/Madrid
